# Hostinger (Apache) settings for the built site. Vite copies this file into dist/ on every build.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use https://biharsetu.in (no www, no plain http).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://biharsetu.in%{REQUEST_URI} [L,R=301]

  # React Router: send every path that is not a real file to index.html (/about, /admin/login, ...).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Build files carry a content hash in their name (index-D8_brqbK.js), so they can be cached for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|avif|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always be re-checked so visitors get a new deployment straight away.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
